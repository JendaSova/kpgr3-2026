# Normalizace konců řádků
* text=auto

# Java a shadery vždy LF
*.java text eol=lf
*.vert text eol=lf
*.frag text eol=lf
*.glsl text eol=lf
*.xml  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.bat  text eol=crlf

# Binární soubory - beze změny
*.jar  binary
*.dll  binary
*.obj  binary
*.jpg  binary
*.png  binary
*.class binary
